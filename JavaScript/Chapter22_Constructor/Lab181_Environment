class Environment {
    constructor(name = "Staging", port = 3000) {
        this.name = name
        this.port = port
    }

    url() {
        console.log("https://www." + this.name + ".com:" + this.port)
    }
}

let env1 = new Environment()
let env2 = new Environment("Production", 8080)

env1.url()
env2.url()